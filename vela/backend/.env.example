PORT=5000
NODE_ENV=development
JWT_ACCESS_SECRET=vela_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=vela_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vela_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vela_db
